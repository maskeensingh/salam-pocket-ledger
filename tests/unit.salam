package main

import os

include money "../src/money.salam"
include dates "../src/dates.salam"
include csv "../src/csv.salam"
include expenses "../src/expenses.salam"
include budgets "../src/budgets.salam"
include summary "../src/summary.salam"

func Check(ok: bool, name: str):
    if not ok:
        printerrln "FAIL: " + name
        os.Exit(1)
    end
end

func main:
    Check(money.Parse("12.34") == 1234, "exact cents")
    Check(money.Parse("0.1") == 10, "one decimal")
    Check(money.Parse("2") == 200, "whole units")
    Check(money.Parse("-1") == -1, "negative rejected")
    Check(money.Parse("1.001") == -1, "no rounding")
    Check(money.Parse("1.") == -1, "missing fraction")
    Check(money.Parse("1e3") == -1, "no scientific notation")
    Check(money.Parse("999999999.99") == 99999999999 as i64, "maximum")
    Check(money.Parse("1000000000") == -1, "overflow guard")
    Check(money.Format(5) == "0.05", "format cents")
    Check(dates.Valid("2024-02-29"), "leap year")
    Check(not dates.Valid("1900-02-29"), "century exception")
    Check(dates.Valid("2000-02-29"), "400 year rule")
    Check(not dates.Valid("2026-04-31"), "month length")
    Check(not dates.Valid("2026-1-01"), "canonical date")
    Check(not dates.Month("2026-13"), "month range")
    mut table := csv.Parse("a,b\r\n\"hello, world\",\"line1\nline2\"\r\n")
    Check(table.error == "" and table.rows.len() == 2, "CSV record count")
    Check(table.rows.get(1).fields.get(0) == "hello, world", "quoted comma")
    Check(table.rows.get(1).fields.get(1) == "line1\nline2", "quoted newline")
    csv.Free(table)
    mut bad := csv.Parse("a,\"never closed")
    Check(bad.error != "", "unclosed CSV rejected")
    csv.Free(bad)
    mut tail := csv.Parse("\"closed\"oops,b")
    Check(tail.error != "", "CSV trailing junk rejected")
    csv.Free(tail)
    mut expenseCsv := csv.Parse("date,category,amount,description\n2026-10-01,food,12.34,Lunch\n")
    mut ledger := expenses.Load(expenseCsv)
    Check(ledger.error == "" and ledger.records.len() == 1, "expense schema")
    Check(ledger.records.get(0).cents == 1234, "expense amount")
    mut budgetCsv := csv.Parse("category,limit\nfood,10\nbooks,20\n")
    mut plan := budgets.Load(budgetCsv)
    Check(plan.error == "", "budget schema")
    mut report := summary.Build(ledger, plan, "2026-10")
    Check(report.total == 1234 and report.count == 1, "monthly total")
    Check(report.categories.get(0).name == "books", "sorted categories")
    Check(report.categories.get(0).spent == 0, "unused budget preserved")
    Check(report.categories.get(1).spent > report.categories.get(1).budget, "over budget")
    report.categories.free()
    mut empty := summary.Build(ledger, plan, "2026-09")
    Check(empty.total == 0 and empty.count == 0, "month filter")
    empty.categories.free()
    plan.items.free()
    csv.Free(budgetCsv)
    ledger.records.free()
    csv.Free(expenseCsv)
    mut invalid := csv.Parse("date,category,amount,description\n2026-02-30,food,1,bad\n")
    mut rejected := expenses.Load(invalid)
    Check(rejected.error != "", "invalid calendar record rejected")
    rejected.records.free()
    csv.Free(invalid)
    mut duplicateCsv := csv.Parse("category,limit\nfood,10\nfood,20\n")
    mut duplicate := budgets.Load(duplicateCsv)
    Check(duplicate.error != "", "duplicate budget rejected")
    duplicate.items.free()
    csv.Free(duplicateCsv)
    println "unit checks passed"
end
